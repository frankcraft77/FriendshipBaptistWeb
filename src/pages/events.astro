---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ASSOCIATION, ENV, SAMPLE_CONTENT } from '../config';
import { SAMPLE_EVENTS } from '../content/site-data';

// Responsive Google Calendar embed, driven by PUBLIC_GOOGLE_CALENDAR_ID.
const calendarSrc = ENV.calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(ENV.calendarId)}&ctz=America%2FChicago&mode=AGENDA&showTitle=0&showPrint=0&showCalendars=0`
  : '';
---

<Base
  title={`Events — ${ASSOCIATION.name}`}
  description="Associational gatherings, trainings, and special services across the Friendship Baptist Association."
>
  <section class="section-tight band">
    <div class="container">
      <p class="eyebrow">Events</p>
      <h1 data-editable="true" data-editable-label="Events page headline">What's coming up</h1>
      <p class="lede" data-editable="true" data-editable-label="Events page intro">
        Gatherings, trainings, and special services from around the association.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {calendarSrc ? (
        <div class="rounded-[var(--radius)] overflow-hidden border" style="border-color: var(--card-border);">
          <iframe
            src={calendarSrc}
            title={`${ASSOCIATION.name} calendar`}
            class="w-full"
            style="height: min(75vh, 640px); border: 0;"
            loading="lazy"
          ></iframe>
        </div>
      ) : (
        <div class="notice">
          The live association calendar will appear here once the Google
          Calendar ID is added (see the README — it's a five-minute setup).
          Meanwhile, the examples below show how events will look.
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Typical annual events {SAMPLE_CONTENT && <span class="tag-sample ml-2">samples</span>}</p>
      <h2>What to expect through the year</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {SAMPLE_EVENTS.map((e) => (
          <div class="card card-hover">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl mb-4" style="background: color-mix(in srgb, var(--accent), transparent 88%); color: var(--accent);">
              <Icon name="calendar" class="w-5 h-5" />
            </span>
            <h3 class="!text-[1.25rem] !mb-2">{e.title}</h3>
            <p class="font-ui text-[0.85rem] !mb-1"><strong>When:</strong> {e.when}</p>
            <p class="font-ui text-[0.85rem] !mb-3"><strong>Where:</strong> {e.where}</p>
            <p class="font-ui text-[0.9rem] muted !m-0">{e.text}</p>
          </div>
        ))}
      </div>
      {SAMPLE_CONTENT && (
        <p class="font-ui text-[0.85rem] muted mt-6">
          These are example cards — typical associational events, not scheduled
          dates. Real events come from the Google Calendar above.
        </p>
      )}
    </div>
  </section>
</Base>
