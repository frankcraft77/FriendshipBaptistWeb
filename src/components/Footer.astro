---
import { ASSOCIATION, SAMPLE_CONTENT } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container py-12 grid gap-10 md:grid-cols-3">
    <div>
      <h3>Friendship Baptist Association</h3>
      <p class="mt-3 leading-relaxed">
        {ASSOCIATION.churchCount} Southern Baptist churches serving Blount County,
        Alabama, together — since {ASSOCIATION.organized}.
      </p>
      <p class="mt-3">
        {ASSOCIATION.officeAddress}
        {SAMPLE_CONTENT && <span class="tag-sample ml-1">verify</span>}
      </p>
    </div>
    <div>
      <h3>Quick links</h3>
      <ul class="mt-3 space-y-2 list-none p-0 m-0">
        <li><a href="/find-a-church/">Find a church near you</a></li>
        <li><a href="/events/">Upcoming events</a></li>
        <li><a href="/missions/">Get involved</a></li>
        <li><a href="/resources/">Church resources</a></li>
        <li><a href="/give/">Give</a></li>
      </ul>
    </div>
    <div>
      <h3>Connect</h3>
      <ul class="mt-3 space-y-2 list-none p-0 m-0">
        <li><a href={ASSOCIATION.facebook} rel="noopener">Facebook</a></li>
        <li><a href="/contact/">Contact the office</a></li>
        <li><a href="/about/">About the association</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container py-5 text-sm flex flex-col sm:flex-row justify-between gap-2 opacity-80">
      <span>&copy; {year} {ASSOCIATION.name}. All rights reserved.</span>
      <span>Affiliated with the Alabama Baptist State Convention &amp; the Southern Baptist Convention</span>
    </div>
  </div>
</footer>
