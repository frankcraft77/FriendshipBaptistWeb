---
import Base from '../layouts/Base.astro';
import { ASSOCIATION, SAMPLE_CONTENT } from '../config';
import { VOLUNTEER_OPPORTUNITIES } from '../content/site-data';
import * as MissionsIntro from '../content/missions-intro.md';
---

<Base
  title={`Missions & Get Involved — ${ASSOCIATION.name}`}
  description="Cooperative missions and volunteer opportunities across the Friendship Baptist Association — serve Blount County and beyond."
>
  <section class="section-tight band">
    <div class="container">
      <div class="contents" data-edit-section="Top of page — headline and intro">
      <p class="eyebrow">Missions &amp; get involved</p>
      <h1>On mission, together</h1>
      <p class="lede">
        From next-door neighbors to the nations — here's how our churches serve,
        and how you can join in.
      </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <div class="contents" data-edit-section="Why we work together">
      <p class="eyebrow">Cooperative missions {SAMPLE_CONTENT && <span class="tag-sample ml-2">sample</span>}</p>
      <h2>Why we work together</h2>
      <div class="prose">
        <MissionsIntro.Content />
      </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow">Ways to serve {SAMPLE_CONTENT && <span class="tag-sample ml-2">samples</span>}</p>
      <h2>Volunteer opportunities</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {VOLUNTEER_OPPORTUNITIES.map((v) => (
          <div class="card card-hover" data-edit-section={`Volunteer card: ${v.title}`}>
            <h3 class="!text-[1.25rem] !mb-2">{v.title}</h3>
            <p class="font-ui text-[0.92rem] muted !m-0">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band-accent section-tight">
    <div class="container text-center">
      <div class="contents" data-edit-section="Bottom banner">
      <h2 class="!mb-3">Ready to get involved?</h2>
      <p class="font-ui opacity-90 !mb-6 max-w-[52ch] mx-auto">
        Tell us how you'd like to serve and we'll connect you with the right
        church or project.
      </p>
      </div>
      <a class="btn btn-on-accent" href="/contact/">Contact the association</a>
    </div>
  </section>
</Base>
