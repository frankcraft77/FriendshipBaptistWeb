# ──────────────────────────────────────────────────────────────────────────
# Friendship Baptist Association website — environment variables
#
# Copy this file to `.env` and fill in real values. The site BUILDS AND RUNS
# FINE with every one of these blank — each feature degrades gracefully —
# but maps, live spreadsheet data, and the calendar need their keys to go
# fully live. Plain-English setup steps for each are in README.md.
# ──────────────────────────────────────────────────────────────────────────

# The site's public URL (used for canonical links, sitemap, Open Graph).
# Set this once the domain is purchased. Example: https://friendshipbaptistassociation.org
PUBLIC_SITE_URL=

# Google Maps API key — powers the church map, address autocomplete
# ("Churches Near Me"), and per-church maps.
# Create at https://console.cloud.google.com → enable "Maps JavaScript API",
# "Geocoding API", and "Places API" → create an API key → restrict it to
# your domain. Without it, the site shows the list view with a notice.
PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA0oXUmRxq0RgxkT3ikEtze4vI7V7P4UZ4

# OPTIONAL server-side key used ONLY at build time to geocode church
# addresses that have no latitude/longitude yet (results are cached in
# src/data/geocache.json). Can be the same key as above if it allows the
# Geocoding API. Never exposed to the browser.
GOOGLE_GEOCODING_API_KEY=AIzaSyA0oXUmRxq0RgxkT3ikEtze4vI7V7P4UZ4

# Published-to-web CSV URL of the Google Sheet that holds the church
# directory (File → Share → Publish to web → choose CSV → copy link).
# If blank or unreachable, the build automatically falls back to the
# committed spreadsheet at src/data/churches.csv.
CHURCHES_SHEET_CSV_URL=

# Google Calendar ID for the association calendar (Calendar settings →
# "Integrate calendar" → Calendar ID, e.g. something@group.calendar.google.com).
# Without it, the Events page shows sample event cards and a notice.
PUBLIC_GOOGLE_CALENDAR_ID=

# Cloudinary cloud name (from your Cloudinary dashboard) — optional, used to
# build optimized image URLs when photos are hosted on Cloudinary.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Form handler endpoint for the Contact page (e.g. a Formspree form URL like
# https://formspree.io/f/abcdwxyz). Without it, the form shows contact
# details and an email link instead of a submit button.
PUBLIC_CONTACT_FORM_ENDPOINT=
