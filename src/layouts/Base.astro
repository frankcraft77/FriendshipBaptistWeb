---
/**
 * Base layout: head metadata, fonts, header/nav, sample-content banner,
 * and footer. Every page uses this.
 */
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SampleBanner from '../components/SampleBanner.astro';
import { ASSOCIATION } from '../config';

interface Props {
  title: string;
  description?: string;
  /** page-scoped color theme keyword (church mini-sites set this) */
  theme?: string;
  /** absolute or site-relative image for social sharing previews */
  ogImage?: string;
  /** keep utility pages (theme showcase) out of search indexes */
  noindex?: boolean;
}

const {
  title,
  description = `${ASSOCIATION.name} — ${ASSOCIATION.churchCount} Southern Baptist churches serving Blount County, Alabama. Find a church near you.`,
  theme,
  ogImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme={theme || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ASSOCIATION.name} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <SampleBanner />
    <Header currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
