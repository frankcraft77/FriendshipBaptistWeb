---
import Base from '../layouts/Base.astro';
import { ASSOCIATION } from '../config';
---

<Base title={`Page not found — ${ASSOCIATION.name}`} noindex={true}>
  <section data-edit-label="Page content" class="section text-center">
    <div class="container container-narrow">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lede mx-auto">
        It may have moved — but the churches haven't. Try one of these:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">Go home</a>
        <a class="btn btn-ghost" href="/find-a-church/">Find a church</a>
        <a class="btn btn-ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>
